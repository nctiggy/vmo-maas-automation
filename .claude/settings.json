{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(kubectl:*)",
      "Bash(mkdocs:*)",
      "Bash(./scripts/31-kubevirt-redfish-bmc.py:*)",
      "Bash(./scripts/build-bmc-automation-profile.py:*)",
      "Bash(./scripts/build-templates-profile.py:*)",
      "Bash(./scripts/find-pack.py:*)",
      "Bash(./scripts/maas-reconciler.py:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/format-and-lint.sh",
            "timeout": 60,
            "statusMessage": "Formatting and linting the changed file"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.sh",
            "timeout": 20,
            "statusMessage": "Loading repo state"
          }
        ]
      }
    ]
  }
}
